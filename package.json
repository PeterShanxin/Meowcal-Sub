{
  "name": "meowcal-sub",
  "version": "0.6.9",
  "description": "On-device subtitle capture and translation for Windows",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev:browser": "vite",
    "dev:tauri-web": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build:web": "vite build",
    "version:check": "node scripts/check-version-sync.mjs",
    "commits:check": "node scripts/check-commit-contract.mjs --base origin/main --head HEAD",
    "runners:check": "node scripts/check-workflow-runners.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "typecheck": "tsc --noEmit",
    "prepare:validation": "pwsh -NoProfile -File scripts/prepare-validation-resources.ps1",
    "dev:backend": "npm run prepare:validation && cd src-tauri && cargo run --locked -- --http-only",
    "format:check": "prettier --check \"src/**/*.{js,ts,css,html}\" \"frontend-tests/**/*.{js,mjs,ts}\" \"scripts/*.mjs\" \"config/**/*.json\" \"*.{js,json,mjs,ts}\"",
    "lint": "node scripts/run-eslint.mjs",
    "maintainability": "node scripts/check-maintainability.mjs",
    "eval:subtitles": "pwsh -NoProfile -File scripts/run-subtitle-eval.ps1",
    "test:frontend": "vitest run --coverage",
    "test:browser": "playwright test",
    "frontend:check": "npm run version:check && npm run runners:check && npm run docs:check && npm run format:check && npm run lint && npm run typecheck && npm run build:web && npm run test:frontend && npm run test:browser",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "4.1.11"
  },
  "keywords": [
    "tauri",
    "subtitle",
    "translation",
    "ocr",
    "on-device-ai"
  ],
  "author": "PeterShanxin",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "lit": "^3.3.3"
  }
}
