{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Meowcal Sub",
  "version": "0.5.0",
  "identifier": "com.meowcal.sub",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "title": "Meowcal Sub"
    },
    "windows": [
      {
        "title": "Meowcal Sub - Setup",
        "label": "main",
        "width": 480,
        "height": 600,
        "resizable": true,
        "center": false,
        "decorations": true,
        "transparent": false,
        "visible": false
      },
      {
        "title": "Select Area",
        "label": "selector",
        "url": "selector.html",
        "fullscreen": true,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": true,
        "focusable": true,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "title": "",
        "label": "overlay",
        "url": "overlay.html",
        "width": 800,
        "height": 600,
        "x": 0,
        "y": 0,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0],
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "title": "Local Translation Setup",
        "label": "foundry-wizard",
        "url": "wizard.html",
        "width": 620,
        "height": 540,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "focus": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/OverlayHost.exe", "resources/*.dll", "resources/*.pri"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": null,
        "sidebarImage": null,
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
